# Copie para .env.local e preencha. O .env.local NUNCA vai para o git nem para
# dentro da imagem Docker (ver .gitignore e .dockerignore).

# --- Públicas: embutidas no bundle pelo `next build` ---------------------------
# Mudou alguma destas? Precisa REBUILDAR a imagem (docker compose up -d --build).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLIC_ANON_KEY=

# --- Só do servidor: lidas em runtime ------------------------------------------
# Mudou? Basta recriar o container (docker compose up -d), sem rebuild.
# E-mails com acesso ao /admin, separados por vírgula. SEM esta variável,
# qualquer conta Google/GitHub que fizer login entra no painel (o RLS do banco
# continua barrando a escrita, mas a interface abre).
ADMIN_EMAILS=carlosmoisesdev@gmail.com
